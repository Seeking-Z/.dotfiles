{
  "hyprland/workspaces": {
    "format": "{icon} {windows}",
    "persistent-workspaces": {
      "*": 5
    },
    "window-rewrite-default": "󰊠",
    "window-rewrite": {
      // --- Work ---
      "kitty": "󰆍",
      "onlyoffice": "󰏆",
      "google-chrome": "",
      "code": "󰨞",
      "azahar": "",
      "obsidian": "󰹕",
      // --- Apps ---
      "discord": "",
      "spotify": "",
      "org.kde.kdeconnect.app": "󰦉",
      "org.qbittorrent.qBittorrent": "󰘿",
      // --- Graphics & Visual ---
      "dolphin": "",
      "yazi": "󰇥",
      "imv": "󰄄",
      "swappy": "󰄄",
      "org.gnome.FileRoller": "",
      "vlc": "󰕼",
      "mpv": "󰕼",
      // --- System ---
      "blueman-manager": "",
      "pavucontrol": "󱕂",
      "nm-connection-editor": "󰐻"
    },
    "format-icons": {
      "special": "󱁂",
      "urgent": "󰊠",
      "empty": ""
    },
    "show-special": true,
    "all-outputs": true
  }
}
